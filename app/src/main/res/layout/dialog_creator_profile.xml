<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Creator Setup Profile"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Gemini reads this profile automatically so every idea fits your real hardware and style."
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edtNiche"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip_dark"
            android:hint="Channel Niche (e.g. PC Gaming, Tech)"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/edtHardware"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_dark"
            android:hint="System Specs (e.g. i5 8GB RAM, Mic)"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/edtTools"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_dark"
            android:hint="Apps / Tools (e.g. DaVinci, BandLab)"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/edtDailyGoal"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_dark"
            android:hint="Daily Creation Goal (Minutes)"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/chkFaceless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:buttonTint="#FF0033"
            android:text="Faceless / Mask Format (No Facecam)"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/chkForceCreate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#FF0033"
            android:text="Force Me to Create Daily Alerts"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#FF0033"
            android:text="Save Profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCloseProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Close"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
